bSaving=0
#define Collision_oPlayer1
/*"/*'/**//* YYD ACTION
lib_id=1
action_id=603
applies_to=self
*/
/*
Save Point script.
This will save the game.
*/
//if (keyboard_check_pressed(ord(global.ctrlUp)) or keyboard_check_pressed(vk_up)) and global.gamePaused=false
if (keyboard_check_pressed(ord(global.ctrlUp)) or (keyboard_check_pressed(vk_up) or scrPadPressed(3))) and global.gamePaused=false //gamepad change: and the gamepad's Up (scrGamepadInit)
{
  playSound(global.snd_MenuConfirm,0,1)
  bSaving=1
  saveProgress=0
  global.recSavedNumber+=1
  stringToShow="Saving, please wait a second..."
  messageWidth=string_width(stringToShow)
  newMessage=instance_create(256-(messageWidth/2),128,oMessageSign)
  newMessage.message=stringToShow
  newMessage.fadingTime=45
  screen_redraw()
  ini_open("GameDetails.ini")
  ini_write_string("ABOUT","Notice","Do not edit this file, doing so could corrupt saved data and cause the game to run incorrectly.")
  var sectionWrite;
  if global.currentQuestLog=1
    sectionWrite="ALPHA"
  else if global.currentQuestLog=2
    sectionWrite="BETA"
  else if global.currentQuestLog=3
    sectionWrite="OMEGA"

  for (i=0;i<1;i+=1)
  {
    for (ii=0;ii<24;ii+=1)
      ini_write_real(sectionWrite,string("d0") +string(i) +string(ii),global.dungeonMapData[i,ii])
  }
  for (i=0;i<1;i+=1)
  {
    for (ii=0;ii<2;ii+=1)
      ini_write_real(sectionWrite,string("i0") +string(i) +string(ii),global.dungeonItems[i,ii])
  }
  saveProgress=10
  screen_redraw()

  var tempVar;
  tempVar=encryptDecrypt(global.p1Level,0); ini_write_real(sectionWrite,"1",tempVar)
  tempVar=encryptDecrypt(global.p1MaxLife,0); ini_write_real(sectionWrite,"2",tempVar)
  tempVar=encryptDecrypt(oPlayer1.life,0); ini_write_real(sectionWrite,"3",tempVar)
  tempVar=encryptDecrypt(global.p1TotalExp,0); ini_write_real(sectionWrite,"4",tempVar)
  tempVar=encryptDecrypt(global.p1CurrentExp,0); ini_write_real(sectionWrite,"5",tempVar)
  tempVar=encryptDecrypt(global.p1ExpNext,0); ini_write_real(sectionWrite,"6",tempVar)
  tempVar=encryptDecrypt(global.p1PhysicalPower,0); ini_write_real(sectionWrite,"7",tempVar)
  tempVar=encryptDecrypt(global.p1PhysicalDefense,0); ini_write_real(sectionWrite,"8",tempVar)
  tempVar=encryptDecrypt(global.p1SpiritPower,0); ini_write_real(sectionWrite,"9",tempVar)
  tempVar=encryptDecrypt(global.p1SpiritDefense,0); ini_write_real(sectionWrite,"10",tempVar)
  tempVar=encryptDecrypt(global.p1MoneyTotal,0); ini_write_real(sectionWrite,"11",tempVar)
  tempVar=encryptDecrypt(global.p1MoneyMax,0); ini_write_real(sectionWrite,"12",tempVar)
  tempVar=encryptDecrypt(global.p1Awesome,0); ini_write_real(sectionWrite,"13",tempVar)
  tempVar=encryptDecrypt(global.p1RaveEnergy,0); ini_write_real(sectionWrite,"14",tempVar)
  tempVar=encryptDecrypt(global.p1SkillPoints,0); ini_write_real(sectionWrite,"15",tempVar)
  tempVar=encryptDecrypt(global.p1HeartPieces,0); ini_write_real(sectionWrite,"16",tempVar)
  ini_write_real(sectionWrite,"17",global.techLv)
  ini_write_real(sectionWrite,"18",global.fireLv)
  ini_write_real(sectionWrite,"19",global.waterLv)
  ini_write_real(sectionWrite,"20",global.windLv)
  ini_write_real(sectionWrite,"21",global.earthLv)
  tempVar=encryptDecrypt(global.p1MaxSpiritEnergy,0); ini_write_real(sectionWrite,"22",tempVar)
  tempVar=encryptDecrypt(oPlayer1.spiritEnergy,0); ini_write_real(sectionWrite,"23",tempVar)
  tempVar=encryptDecrypt(global.p1MaxFireEnergy,0); ini_write_real(sectionWrite,"24",tempVar)
  tempVar=encryptDecrypt(oPlayer1.fireEnergy,0); ini_write_real(sectionWrite,"25",tempVar)
  tempVar=encryptDecrypt(global.p1MaxWaterEnergy,0); ini_write_real(sectionWrite,"26",tempVar)
  tempVar=encryptDecrypt(oPlayer1.waterEnergy,0); ini_write_real(sectionWrite,"27",tempVar)
  tempVar=encryptDecrypt(global.p1MaxWindEnergy,0); ini_write_real(sectionWrite,"28",tempVar)
  tempVar=encryptDecrypt(oPlayer1.windEnergy,0); ini_write_real(sectionWrite,"29",tempVar)
  tempVar=encryptDecrypt(global.p1MaxEarthEnergy,0); ini_write_real(sectionWrite,"30",tempVar)
  tempVar=encryptDecrypt(oPlayer1.earthEnergy,0); ini_write_real(sectionWrite,"31",tempVar)
  tempVar=encryptDecrypt(global.p1FIREresist,0); ini_write_real(sectionWrite,"32",tempVar)
  tempVar=encryptDecrypt(global.p1WATERresist,0); ini_write_real(sectionWrite,"33",tempVar)
  tempVar=encryptDecrypt(global.p1WINDresist,0); ini_write_real(sectionWrite,"34",tempVar)
  tempVar=encryptDecrypt(global.p1EARTHresist,0); ini_write_real(sectionWrite,"35",tempVar)
  ini_write_real(sectionWrite,"36",global.p1CurrentElement)
  ini_write_string(sectionWrite,"37",global.p1TechniqueEquip)
  ini_write_string(sectionWrite,"38",global.p1SpellEquip)
  ini_write_string(sectionWrite,"39",global.p1FireEquip)
  ini_write_string(sectionWrite,"40",global.p1WaterEquip)
  ini_write_string(sectionWrite,"41",global.p1WindEquip)
  ini_write_string(sectionWrite,"42",global.p1EarthEquip)
  ini_write_real(sectionWrite,"43",global.hasWindBoots)
  ini_write_real(sectionWrite,"44",global.hasSuaveToken)
  ini_write_real(sectionWrite,"45",global.hasItemFinder)
  saveProgress=20
  screen_redraw()

  ini_write_real(sectionWrite,"101",global.SkSharpen)
  ini_write_real(sectionWrite,"102",global.SkComboMaster)
  ini_write_real(sectionWrite,"103",global.SkSmash)
  ini_write_real(sectionWrite,"104",global.SkExpertise)
  ini_write_real(sectionWrite,"105",global.SkFireAffinity)
  ini_write_real(sectionWrite,"106",global.SkWaterAffinity)
  ini_write_real(sectionWrite,"107",global.SkWindAffinity)
  ini_write_real(sectionWrite,"108",global.SkEarthAffinity)
  ini_write_real(sectionWrite,"109",global.SkFireResist)
  ini_write_real(sectionWrite,"110",global.SkWaterResist)
  ini_write_real(sectionWrite,"111",global.SkWindResist)
  ini_write_real(sectionWrite,"112",global.SkEarthResist)
  ini_write_real(sectionWrite,"113",global.SkIronBody)
  ini_write_real(sectionWrite,"114",global.SkFreeSpirit)
  ini_write_real(sectionWrite,"115",global.SkAgility)
  ini_write_real(sectionWrite,"116",global.SkSwiftFoot)
  ini_write_real(sectionWrite,"117",global.SkQuickRecovery)
  ini_write_real(sectionWrite,"118",global.SkPrecision)
  ini_write_real(sectionWrite,"119",global.SkPerfection)
  ini_write_real(sectionWrite,"120",global.SkVirtue)
  ini_write_real(sectionWrite,"121",global.SkSpiritMaster)
  ini_write_real(sectionWrite,"122",global.SkFireMastery)
  ini_write_real(sectionWrite,"123",global.SkFireCraft)
  ini_write_real(sectionWrite,"124",global.SkWaterMastery)
  ini_write_real(sectionWrite,"125",global.SkWaterCraft)
  ini_write_real(sectionWrite,"126",global.SkElementalMaster)
  ini_write_real(sectionWrite,"127",global.SkWindMastery)
  ini_write_real(sectionWrite,"128",global.SkWindCraft)
  ini_write_real(sectionWrite,"129",global.SkGoodFortune)
  ini_write_real(sectionWrite,"130",global.SkStatistician)
  ini_write_real(sectionWrite,"131",global.SkEarthMastery)
  ini_write_real(sectionWrite,"132",global.SkEarthCraft)
  ini_write_real(sectionWrite,"133",global.SkFaith)
  ini_write_real(sectionWrite,"134",global.SkProtection)
  ini_write_real(sectionWrite,"135",global.SkStrategist)
  ini_write_real(sectionWrite,"136",global.SkDashPower)

  ini_write_real(sectionWrite,"201",global.playTimeHour)
  ini_write_real(sectionWrite,"202",global.playTimeMinute)
  ini_write_real(sectionWrite,"203",global.playTimeSecond)
  saveProgress=30
  screen_redraw()

  ini_write_real(sectionWrite,"302",global.gameProgress)
  ini_write_real(sectionWrite,"303",global.currentQuestLog)
  tempVar=encryptDecrypt(global.p1KillCount,0); ini_write_real(sectionWrite,"304",tempVar)
  tempVar=encryptDecrypt(global.deathCount,0); ini_write_real(sectionWrite,"305",tempVar)
  ini_write_real(sectionWrite,"306",global.difficulty)
  ini_write_real(sectionWrite,"307",global.targetMapX)
  ini_write_real(sectionWrite,"308",global.targetMapY)
  tempVar=encryptDecrypt(global.p1Keys,0); ini_write_real(sectionWrite,"309",tempVar)
  ini_write_real(sectionWrite,"310",global.muffins)
  ini_write_string(sectionWrite,"311",global.location)
  ini_write_real(sectionWrite,"312",global.rbSwitchBlueOn)
  ini_write_real(sectionWrite,"313",global.targetMap)
  ini_write_real(sectionWrite,"314",global.teleportEnabled)
  ini_write_real(sectionWrite,"315",global.MMnapalmProg)
  ini_write_real(sectionWrite,"316",global.MMgyroProg)
  ini_write_real(sectionWrite,"317",global.MMdiveProg)
  ini_write_real(sectionWrite,"318",global.MMmysteryProg)
  ini_write_real(sectionWrite,"319",global.shroudThreat)
  ini_write_real(sectionWrite,"320",global.sofsMax)
  for (i=0;i<4;i+=1)
    ini_write_real(sectionWrite,string("321p") +string(i),global.VDportals[i])

  tempVar=encryptDecrypt(global.shotWW_Highscore,0); ini_write_real(sectionWrite,"381",tempVar)
  tempVar=encryptDecrypt(global.shotDSE_Highscore,0); ini_write_real(sectionWrite,"382",tempVar)
  saveProgress=40
  screen_redraw()

  tempVar=encryptDecrypt(global.recPhysicalAttacks,0); ini_write_real(sectionWrite,"401",tempVar)
  tempVar=encryptDecrypt(global.recPhysicalHitsConnected,0); ini_write_real(sectionWrite,"402",tempVar)
  tempVar=encryptDecrypt(global.recTechsUsed,0); ini_write_real(sectionWrite,"403",tempVar)
  tempVar=encryptDecrypt(global.recTechsConnected,0); ini_write_real(sectionWrite,"405",tempVar)
  tempVar=encryptDecrypt(global.recSpellsCast,0); ini_write_real(sectionWrite,"406",tempVar)
  tempVar=encryptDecrypt(global.recSpellsConnected,0); ini_write_real(sectionWrite,"407",tempVar)
  tempVar=encryptDecrypt(global.recDashedForward,0); ini_write_real(sectionWrite,"408",tempVar)
  tempVar=encryptDecrypt(global.recDashedBackward,0); ini_write_real(sectionWrite,"409",tempVar)
  tempVar=encryptDecrypt(global.recDamageDealt,0); ini_write_real(sectionWrite,"410",tempVar)
  tempVar=encryptDecrypt(global.recDamageTaken,0); ini_write_real(sectionWrite,"411",tempVar)
  tempVar=encryptDecrypt(global.recTakenDamageNumber,0); ini_write_real(sectionWrite,"412",tempVar)
  tempVar=encryptDecrypt(global.recMaxHitCombo,0); ini_write_real(sectionWrite,"413",tempVar)
  tempVar=encryptDecrypt(global.recMaxKillChain,0); ini_write_real(sectionWrite,"414",tempVar)
  tempVar=encryptDecrypt(global.recMaxKillingSpree,0); ini_write_real(sectionWrite,"415",tempVar)
  tempVar=encryptDecrypt(global.recCrippledTargetNumber,0); ini_write_real(sectionWrite,"416",tempVar)
  tempVar=encryptDecrypt(global.recElementsFused,0); ini_write_real(sectionWrite,"417",tempVar)
  tempVar=encryptDecrypt(global.recEnemiesScanned,0); ini_write_real(sectionWrite,"418",tempVar)
  tempVar=encryptDecrypt(global.recLongestIdleTime,0); ini_write_real(sectionWrite,"419",tempVar)
  tempVar=encryptDecrypt(global.recPeopleTalkedTo,0); ini_write_real(sectionWrite,"420",tempVar)
  tempVar=encryptDecrypt(global.recUsedAreaExit,0); ini_write_real(sectionWrite,"421",tempVar)
  tempVar=encryptDecrypt(global.recJumped,0); ini_write_real(sectionWrite,"422",tempVar)
  tempVar=encryptDecrypt(global.recMostPowerfulJumpAttack,0); ini_write_real(sectionWrite,"423",tempVar)
  tempVar=encryptDecrypt(global.recUsedRaveMode,0); ini_write_real(sectionWrite,"424",tempVar)
  tempVar=encryptDecrypt(global.recAchievementsCompleted,0); ini_write_real(sectionWrite,"425",tempVar)
  tempVar=encryptDecrypt(global.recWeakestHit,0); ini_write_real(sectionWrite,"426",tempVar)
  tempVar=encryptDecrypt(global.recStrongestHitInRave,0); ini_write_real(sectionWrite,"427",tempVar)
  tempVar=encryptDecrypt(global.recStrongestHitNoRave,0); ini_write_real(sectionWrite,"428",tempVar)
  tempVar=encryptDecrypt(global.recSavedNumber,0); ini_write_real(sectionWrite,"429",tempVar)
  tempVar=encryptDecrypt(global.recFallenOffLevelNumber,0); ini_write_real(sectionWrite,"430",tempVar)
  tempVar=encryptDecrypt(global.recItemsUsed,0); ini_write_real(sectionWrite,"431",tempVar)
  tempVar=encryptDecrypt(global.recItemsBought,0); ini_write_real(sectionWrite,"432",tempVar)
  tempVar=encryptDecrypt(global.recTotalInternetzEarned,0); ini_write_real(sectionWrite,"433",tempVar)
  tempVar=encryptDecrypt(global.recTotalInternetzSpent,0); ini_write_real(sectionWrite,"434",tempVar)
  tempVar=encryptDecrypt(global.recOpenedMenuNumber,0); ini_write_real(sectionWrite,"435",tempVar)
  tempVar=encryptDecrypt(global.recTimeSpentOffscreen,0); ini_write_real(sectionWrite,"436",tempVar)
  tempVar=encryptDecrypt(global.recObjectsBroken,0); ini_write_real(sectionWrite,"437",tempVar)
  tempVar=encryptDecrypt(global.recDistanceRun,0); ini_write_real(sectionWrite,"438",tempVar)
  tempVar=encryptDecrypt(global.recDistanceInAir,0); ini_write_real(sectionWrite,"439",tempVar)
  tempVar=encryptDecrypt(global.recQuestionMarkBlocksHit,0); ini_write_real(sectionWrite,"440",tempVar)
  tempVar=encryptDecrypt(global.recSeenKirby,0); ini_write_real(sectionWrite,"441",tempVar)
  tempVar=encryptDecrypt(global.recSeenMichaelJackson,0); ini_write_real(sectionWrite,"442",tempVar)
  tempVar=encryptDecrypt(global.recSignsRead,0); ini_write_real(sectionWrite,"443",tempVar)
  tempVar=encryptDecrypt(global.recEasyTime,0); ini_write_real(sectionWrite,"444",tempVar)
  tempVar=encryptDecrypt(global.recNormalTime,0); ini_write_real(sectionWrite,"445",tempVar)
  tempVar=encryptDecrypt(global.recHardTime,0); ini_write_real(sectionWrite,"446",tempVar)
  tempVar=encryptDecrypt(global.recAirDashed,0); ini_write_real(sectionWrite,"447",tempVar)
  tempVar=encryptDecrypt(global.recBinariesRead,0); ini_write_real(sectionWrite,"448",tempVar)
  tempVar=encryptDecrypt(global.recBusterShotsUsed,0); ini_write_real(sectionWrite,"449",tempVar)
  tempVar=encryptDecrypt(global.recMaxBubbles,0); ini_write_real(sectionWrite,"450",tempVar)
  tempVar=encryptDecrypt(global.recBlazingAppear,0); ini_write_real(sectionWrite,"451",tempVar)
  saveProgress=50
  screen_redraw()

  //settings change: Options and Controls aren't kept in the save any more: they're global, in Settings.ini (scrSettingsSave)
  //ini_write_real(sectionWrite,"501",global.optLowHealthWarn)
  //ini_write_real(sectionWrite,"502",global.optShowExpEarned)
  //ini_write_real(sectionWrite,"503",global.optShowDamage)
  //ini_write_real(sectionWrite,"504",global.optEnemyStatus)
  //ini_write_real(sectionWrite,"505",global.optKeepMenuPosition)
  //ini_write_real(sectionWrite,"506",global.optMusic)
  //ini_write_real(sectionWrite,"507",global.optIdentifier)
  //ini_write_real(sectionWrite,"508",global.optKillChainScreen)
  //ini_write_real(sectionWrite,"509",global.optKillChainSound)
  //ini_write_real(sectionWrite,"510",global.optKillingSpreeScreen)
  //ini_write_real(sectionWrite,"511",global.optKillingSpreeSound)
  //ini_write_real(sectionWrite,"512",global.optCombo)
  //ini_write_real(sectionWrite,"513",global.optShowAwesome)
  //ini_write_real(sectionWrite,"514",global.optEnemyHP)
  //ini_write_real(sectionWrite,"515",global.optSound)
  //ini_write_real(sectionWrite,"516",global.optShowGlow)
  //ini_write_real(sectionWrite,"517",global.gamePriority)
  //ini_write_real(sectionWrite,"518",global.optGameDetail)
  //ini_write_real(sectionWrite,"519",global.optDPadDash)
  //ini_write_real(sectionWrite,"520",global.optRightIsForward)
  //ini_write_real(sectionWrite,"521",global.optShowHUD)
  saveProgress=60
  screen_redraw()

  ini_write_string(sectionWrite,"601",global.p1WeaponGem)
  ini_write_string(sectionWrite,"602",global.p1Armor)
  ini_write_string(sectionWrite,"603",global.p1Ring)
  tempVar=encryptDecrypt(global.priceWeaponGem,0); ini_write_real(sectionWrite,"605",tempVar)
  tempVar=encryptDecrypt(global.priceArmor,0); ini_write_real(sectionWrite,"606",tempVar)
  tempVar=encryptDecrypt(global.priceRing,0); ini_write_real(sectionWrite,"607",tempVar)
  tempVar=encryptDecrypt(global.priceBracelet,0); ini_write_real(sectionWrite,"608",tempVar)
  ini_write_real(sectionWrite,"609",global.stockWeaponGem)
  ini_write_real(sectionWrite,"610",global.stockArmor)
  ini_write_real(sectionWrite,"611",global.stockRing)
  ini_write_real(sectionWrite,"612",global.p1BraceletSlots)
  saveProgress=70
  screen_redraw()

  tempVar=encryptDecrypt(oPlayer1.conSkittles,0); ini_write_real(sectionWrite,"701",tempVar)
  tempVar=encryptDecrypt(oPlayer1.conSmoothie,0); ini_write_real(sectionWrite,"702",tempVar)
  tempVar=encryptDecrypt(oPlayer1.conStarburst,0); ini_write_real(sectionWrite,"703",tempVar)
  tempVar=encryptDecrypt(oPlayer1.conGummyBears,0); ini_write_real(sectionWrite,"704",tempVar)

  //settings change: nor the controls (see above; the Pause Menu key, gamepad and DPad Spells ones that followed these are gone)
  //ini_write_string(sectionWrite,"801",global.ctrlUp)
  //ini_write_string(sectionWrite,"802",global.ctrlDown)
  //ini_write_string(sectionWrite,"803",global.ctrlLeft)
  //ini_write_string(sectionWrite,"804",global.ctrlRight)
  //ini_write_string(sectionWrite,"805",global.ctrlAttack)
  //ini_write_string(sectionWrite,"806",global.ctrlJump)
  //ini_write_string(sectionWrite,"807",global.ctrlTech)
  //ini_write_string(sectionWrite,"808",global.ctrlSpell)
  //ini_write_string(sectionWrite,"809",global.ctrlCycleBack)
  //ini_write_string(sectionWrite,"810",global.ctrlCycleForward)
  //ini_write_string(sectionWrite,"811",global.ctrlRave)
  //ini_write_string(sectionWrite,"812",global.ctrlAbilityBack)
  //ini_write_string(sectionWrite,"813",global.ctrlAbilityForward)
  //ini_write_string(sectionWrite,"814",global.ctrlDashLeft)
  //ini_write_string(sectionWrite,"815",global.ctrlDashRight)
  saveProgress=80
  screen_redraw()

  for (i=0;i<=global.maxSkillCapsules;i+=1)
    ini_write_real(sectionWrite,string("90") +string(i),global.skillCapsules[i])
  for (i=0;i<=global.maxMoneyChest;i+=1)
    ini_write_real(sectionWrite,string("91") +string(i),global.moneyChest[i])
  for (i=0;i<=global.maxItemChest;i+=1)
    ini_write_real(sectionWrite,string("92") +string(i),global.itemChest[i])
  saveProgress=90
  screen_redraw()

  for (i=0;i<=global.maxHeartPiece;i+=1)
    ini_write_real(sectionWrite,string("93") +string(i),global.heartPiece[i])
  for (i=0;i<=global.maxSpiritAuras;i+=1)
    ini_write_real(sectionWrite,string("94") +string(i),global.spiritAuras[i])
  for (i=0;i<=global.maxTechCapsules;i+=1)
    ini_write_real(sectionWrite,string("95") +string(i),global.techCapsule[i])
  for (i=0;i<=global.maxSwitchTriggers;i+=1)
    ini_write_real(sectionWrite,string("96") +string(i),global.switchTrigger[i])
  for (i=0;i<=global.maxDoors;i+=1)
  {
    ini_write_real(sectionWrite,string("97") +string(i),global.doorKeys[i])
    ini_write_real(sectionWrite,string("98") +string(i),global.lockedDoors[i])
  }
  for(i=0;i<18;i+=1)
    ini_write_real(sectionWrite,string("99") +string(i),global.invBracelet[i])
  ini_close()
  sleep(10)
  with oMessageSign
    instance_destroy()
  stringToShow="Game Saved!!"
  messageWidth=string_width(stringToShow)
  newMessage=instance_create(floor(256-(messageWidth/2)),128,oMessageSign)
  newMessage.message=stringToShow
  newMessage.fadingTime=45
  bSaving=0
}
#define Draw_0
/*"/*'/**//* YYD ACTION
lib_id=1
action_id=603
applies_to=self
*/
draw_sprite(sprite_index,-1,x,y)
draw_set_color(make_color_rgb(0,255,0))
draw_set_font(fnt_CombatData)
draw_set_alpha(1)
draw_set_halign(fa_center)
draw_text(x,y-64,"Press Up here#to save")

if bSaving=1
{
  draw_set_halign(fa_right)
  draw_text(252,160,saveProgress)
  draw_set_halign(fa_left)
  draw_text(254,160,"%")
}
