/*
controls change (added): the default keyboard controls, as oInitializeGame sets them for a new game; for "Set to Default
Controls" in the Keyboard Controls panel (menuControlConfig). Pause Menu ([P]) can be set now too.
*/
global.ctrlUp="W"
global.ctrlDown="S"
global.ctrlLeft="A"
global.ctrlRight="D"
global.ctrlAttack="K"
global.ctrlJump="J"
global.ctrlTech="L"
global.ctrlSpell="O"
global.ctrlCycleBack="U"
global.ctrlCycleForward="I"
global.ctrlRave="M"
global.ctrlAbilityBack="Z"
global.ctrlAbilityForward="C"
global.ctrlDashLeft="Q"
global.ctrlDashRight="E"
global.ctrlPause="P"
