/*
This script is used to load in saved data from "GameDetails.ini".
argument0:  0: Load from Title Screen
            1: Load from Game Over Screen
*/

ini_open("GameDetails.ini")
if argument0=0
{
  if fileCursorPos=2
    sectionRead="ALPHA"
  else if fileCursorPos=3
    sectionRead="BETA"
  else if fileCursorPos=4
    sectionRead="OMEGA"
}
else if argument0=1
{
  if global.currentQuestLog=1
    sectionRead="ALPHA"
  else if global.currentQuestLog=2
    sectionRead="BETA"
  else if global.currentQuestLog=3
    sectionRead="OMEGA"
}

for (i=0;i<1;i+=1)
{
  for (ii=0;ii<24;ii+=1)
    global.dungeonMapData[i,ii]=ini_read_real(sectionRead,string("d0") +string(i) +string(ii),0)
}
for (i=0;i<1;i+=1)
{
  for (ii=0;ii<2;ii+=1)
    global.dungeonItems[i,ii]=ini_read_real(sectionRead,string("i0") +string(i) +string(ii),0)
}

global.p1Level=ini_read_real(sectionRead,"1",1); global.p1Level=encryptDecrypt(global.p1Level,1)
