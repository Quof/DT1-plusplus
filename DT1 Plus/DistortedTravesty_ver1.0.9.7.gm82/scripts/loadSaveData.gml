for (i=0;i<=global.maxSpiritAuras;i+=1)
  global.spiritAuras[i]=ini_read_real(sectionRead,string("94") +string(i),0)
for (i=0;i<=global.maxTechCapsules;i+=1)
  global.techCapsule[i]=ini_read_real(sectionRead,string("95") +string(i),0)
for (i=0;i<=global.maxSwitchTriggers;i+=1)
  global.switchTrigger[i]=ini_read_real(sectionRead,string("96") +string(i),0)
for (i=0;i<=global.maxDoors;i+=1)
{
  global.doorKeys[i]=ini_read_real(sectionRead,string("97") +string(i),0)
  global.lockedDoors[i]=ini_read_real(sectionRead,string("98") +string(i),0)
}
for (i=0;i<18;i+=1)
  global.invBracelet[i]=ini_read_real(sectionRead,string("99") +string(i),0)
ini_close()
